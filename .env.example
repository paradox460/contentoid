# Settings for compose.yml. Copy to .env next to it and fill in.

# The database password; any string.
POSTGRES_PASSWORD=change-me
# Signs sessions and cookies: `openssl rand -base64 48`.
SECRET_KEY_BASE=
# Where downloads go: an absolute path you've created, without `~`.
DOWNLOAD_DIR=/srv/contentoid
# `id -u` / `id -g` of the user who should own the downloaded files.
PUID=1000
PGID=1000
# The Docker socket's group. Linux: `stat -c %g /var/run/docker.sock`. Docker Desktop and OrbStack: 0.
DOCKER_GID=

# The name browsers use to reach Contentoid; LiveView refuses other origins.
# PHX_HOST=localhost
# Where the web UI listens; 0.0.0.0:4100 for the LAN.
# PUBLISH=127.0.0.1:4100
# true redirects to HTTPS, for use behind a TLS proxy (docs/deployment.md).
# FORCE_SSL=false
# An image tag: latest, a version (0.0.1, 0.0) or edge (main).
# CONTENTOID_VERSION=latest
# The host's Docker socket.
# DOCKER_SOCKET=/var/run/docker.sock
# The site's language and formats when a browser asks for none Contentoid has (BCP 47).
# DEFAULT_LOCALE=en
